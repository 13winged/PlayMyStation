# ---- Telegram ----
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ---- Postgres ----
DATABASE_URL=postgresql+asyncpg://playmystation:playmystation@postgres:5432/playmystation
# ---- Redis ----
REDIS_URL=redis://redis:6379/0
# ---- Security (сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ----
FERNET_KEY=CHANGE_ME_44_BYTES_BASE64_URLSAFE_KEY_HERE
# Старые ключи через запятую — только для чтения при ротации (см. README).
# FERNET_KEYS_OLD=old_key_here
# ---- Spotify OAuth ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/oauth/spotify/callback
# ---- Прокси только для Яндекс Музыки (очередь + download-info виснут с DC-IP) ----
# Формат: http://user:pass@host:port. Пусто — напрямую.
# YANDEX_PROXY_URL=
# ---- YouTube Music: OAuth device-flow (рекомендуется) или browser auth ----
# 1) Google Cloud Console → новый проект → включить YouTube Data API v3 →
#    Credentials → Create Credentials → OAuth client ID →
#    тип «TVs and Limited Input devices» → вписать ID/секрет ниже.
#    Бот: /youtube → открыть ссылку → ввести код → готово (без DevTools).
YTM_OAUTH_CLIENT_ID=
YTM_OAUTH_CLIENT_SECRET=
# 2) Fallback без серверных ключей: /youtube <полные заголовки из music.youtube.com>
#    (Copy Request Headers). Хранятся в БД в зашифрованном виде, живут ~2 года.
# ---- Last.fm (только API-ключ сервера; юзернейм вводит юзер через /lastfm) ----
# Ключ: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# ---- Ynison-прокси (realtime Яндекс Музыки; в compose доступен как сервис ynison) ----
YNISON_PROXY_HOST=ynison
YNISON_PROXY_PORT=50051
# ---- Web (FastAPI OAuth callbacks) ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# ---- Наблюдаемость (Milestone 3) ----
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# LOG_FORMAT=text  # json — для прода (структурированные логи)
# ---- Кеш аудио: приватный канал для повторной отдачи по file_id ----
# Создай приватный канал, добавь бота админом, впиши ID (узнать: @getmyid_bot):
# AUDIO_CACHE_CHANNEL_ID=-1001234567890
# ---- Бэкапы Postgres (backup-сервис: pg_dump daily 03:00 в volume pgbackups) ----
# BACKUP_RETENTION_DAYS=7

# ---- Webhook (опционально, для продакшена) ----
# WEBHOOK_URL=https://your-domain.com  (без пути — путь из WEBHOOK_PATH добавится сам)
# WEBHOOK_SECRET=your-secret-token-32-chars-min
# WEBHOOK_PATH=/webhook
