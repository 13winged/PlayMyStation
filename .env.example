# ---- Telegram ----
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ---- Postgres ----
DATABASE_URL=postgresql+asyncpg://playmystation:playmystation@postgres:5432/playmystation
# ---- Redis ----
REDIS_URL=redis://redis:6379/0
# ---- Security (сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ----
FERNET_KEY=CHANGE_ME_44_BYTES_BASE64_URLSAFE_KEY_HERE
# ---- Spotify OAuth ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/oauth/spotify/callback
# ---- YouTube Music (browser auth через ytmusicapi: серверных ключей не нужно) ----
# Привязка: /youtube <полные заголовки из music.youtube.com> (Copy Request Headers).
# Хранятся в БД в зашифрованном виде, живут пока жива сессия в браузере (~2 года).
# ---- Last.fm (только API-ключ сервера; юзернейм вводит юзер через /lastfm) ----
# Ключ: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# ---- Ynison-прокси (realtime Яндекс Музыки; в compose доступен как сервис ynison) ----
YNISON_PROXY_HOST=ynison
YNISON_PROXY_PORT=50051
# ---- Web (FastAPI OAuth callbacks) ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
# ---- Наблюдаемость (Milestone 3) ----
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# LOG_FORMAT=text  # json — для прода (структурированные логи)

# ---- Webhook (опционально, для продакшена) ----
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your-secret-token-32-chars-min
# WEBHOOK_PATH=/webhook
